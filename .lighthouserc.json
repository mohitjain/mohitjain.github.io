{
  "ci": {
    "collect": {
      "staticDistDir": "./_site",
      "url": [
        "/index.html",
        "/hello-world/index.html",
        "/archive/index.html",
        "/tags/index.html",
        "/search/index.html",
        "/about/index.html",
        "/404.html"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    }
  }
}
