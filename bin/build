#!/usr/bin/env bash
# Build the site and its Pagefind search index into _site/.
# Usage: bin/build [extra jekyll build flags]
set -euo pipefail
cd "$(dirname "$0")/.."

PAGEFIND_VERSION="1.5.2"

# INCLUDE_DRAFTS=1 also builds _drafts/ (CI uses it so the article template is tested)
JEKYLL_ENV=production bundle exec jekyll build ${INCLUDE_DRAFTS:+--drafts} "$@"
npx --yes "pagefind@${PAGEFIND_VERSION}" --site _site
