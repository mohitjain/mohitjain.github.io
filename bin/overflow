#!/usr/bin/env node
// Phone-width test: does any page scroll sideways? Checks light and dark.
// Usage: bin/overflow <path>...   (site at $SITE, default http://localhost:4000)
// Elements inside <pre> or inside any box that scrolls sideways on its own are ignored.
import { spawn } from "node:child_process";
import { mkdtempSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";

const paths = process.argv.slice(2);
if (!paths.length) { console.error("usage: bin/overflow <path>..."); process.exit(2); }
const site = process.env.SITE || "http://localhost:4000";
const chromeBin = process.env.CHROME || "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome";
const port = 9400 + Math.floor(Math.random() * 400);
const chrome = spawn(chromeBin, ["--headless=new", "--disable-gpu", `--remote-debugging-port=${port}`,
  `--user-data-dir=${mkdtempSync(join(tmpdir(), "overflow-"))}`, "about:blank"], { stdio: "ignore" });
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
let targets;
for (let i = 0; i < 40; i++) { try { targets = await (await fetch(`http://127.0.0.1:${port}/json`)).json(); if (targets.length) break; } catch {} await sleep(250); }
const ws = new WebSocket(targets.find((t) => t.type === "page").webSocketDebuggerUrl);
await new Promise((r) => ws.addEventListener("open", r));
let id = 0; const pending = new Map();
ws.addEventListener("message", (m) => { const d = JSON.parse(m.data); if (d.id && pending.has(d.id)) pending.get(d.id)(d); });
const send = (method, params = {}) => new Promise((r) => { const i = ++id; pending.set(i, r); ws.send(JSON.stringify({ id: i, method, params })); });
await send("Page.enable");
await send("Emulation.setDeviceMetricsOverride", { width: 360, height: 740, deviceScaleFactor: 1, mobile: true });
const expr = `(() => { const w = document.documentElement.clientWidth;
  const scrolls = (e) => { for (let n = e.parentElement; n && n.tagName !== "MAIN"; n = n.parentElement) { if (/(auto|scroll|hidden)/.test(getComputedStyle(n).overflowX)) return true; } return false; };
  const bad = [...document.querySelectorAll("main *")].filter((e) => { const b = e.getBoundingClientRect(); return b.right > w + 1 && !e.closest("pre") && !scrolls(e) && b.width > 0; })
    .slice(0, 3).map((e) => e.tagName.toLowerCase() + "." + e.className);
  return JSON.stringify({ scrollWidth: document.documentElement.scrollWidth, width: w, bad }); })()`;
let failed = false;
for (const p of paths) {
  // A page that does not load must fail, not pass by showing Chrome's error page.
  let status = 0;
  try { status = (await fetch(site + p)).status; } catch {}
  if (status !== 200) { failed = true; console.log(`FAIL ${p} HTTP ${status || "no response"} from ${site}`); continue; }
  for (const theme of ["light", "dark"]) {
    await send("Page.navigate", { url: site + p }); await sleep(900);
    await send("Runtime.evaluate", { expression: `document.documentElement.setAttribute("data-theme","${theme}")` });
    const r = JSON.parse((await send("Runtime.evaluate", { returnByValue: true, expression: expr })).result.result.value);
    const ok = r.scrollWidth <= r.width + 1 && r.bad.length === 0;
    if (!ok) failed = true;
    console.log(`${ok ? "ok  " : "FAIL"} ${p} ${theme}${ok ? "" : " " + JSON.stringify(r)}`);
  }
}
chrome.kill(); process.exit(failed ? 1 : 0);
