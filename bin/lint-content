#!/usr/bin/env ruby
# Check post front matter against the site's conventions.
# Published posts (_posts/) must pass; drafts (_drafts/) only produce warnings.
# Required: title, description, one topic in categories. content_type is optional.
# Tags must come from _data/tags.yml (at most 4 per post); slugs are lowercase with hyphens, at most 5 words.
# Posts with `sample: true` are skipped. Entries in _data/reading.yml are checked too.
# Usage: bin/lint-content
require "yaml"
require "date"

root = File.expand_path("..", __dir__)
topics = Dir[File.join(root, "_topics", "*.md")].map { |f| File.basename(f, ".md") }
types = YAML.load_file(File.join(root, "_data", "content_types.yml")).keys
allowed_tags = YAML.load_file(File.join(root, "_data", "tags.yml")).keys
MAX_TAGS = 4
MAX_SLUG_WORDS = 5

errors = 0
{ "_posts" => :error, "_drafts" => :warn }.each do |dir, level|
  Dir[File.join(root, dir, "**", "*.md")].sort.each do |file|
    text = File.read(file)
    match = text.match(/\A---\s*\n(.*?)\n---\s*\n/m)
    problems = []
    if match.nil?
      problems << "no front matter"
    else
      fm = YAML.safe_load(match[1], permitted_classes: [Date, Time]) || {}
      next if fm["sample"]
      problems << "missing title" if fm["title"].to_s.strip.empty?
      problems << "missing description" if fm["description"].to_s.strip.empty?
      cats = Array(fm["categories"])
      problems << "categories must contain one of: #{topics.join(', ')}" if cats.empty? || (cats - topics).any?
      tags = Array(fm["tags"]).map(&:to_s)
      unknown = tags - allowed_tags
      problems << "tags not in _data/tags.yml: #{unknown.join(', ')}" if unknown.any?
      problems << "too many tags (#{tags.size}); use at most #{MAX_TAGS}" if tags.size > MAX_TAGS
      slug = File.basename(file, ".md").sub(/\A\d{4}-\d{2}-\d{2}-/, "")
      problems << "filename slug '#{slug}' must be lowercase letters, digits and hyphens" unless slug.match?(/\A[a-z0-9]+(-[a-z0-9]+)*\z/)
      problems << "filename slug '#{slug}' has #{slug.split('-').size} words; keep it to #{MAX_SLUG_WORDS}" if slug.split("-").size > MAX_SLUG_WORDS
      if fm.key?("content_type") && !fm["content_type"].to_s.empty? && !types.include?(fm["content_type"])
        problems << "content_type, if set, must be one of: #{types.join(', ')}"
      end
    end
    next if problems.empty?

    label = level == :error ? "ERROR" : "warning"
    puts "#{label}: #{file.sub(root + '/', '')}: #{problems.join('; ')}"
    errors += 1 if level == :error
  end
end

# Reading list (_data/reading.yml): required fields, known kinds, sane links, images that exist.
reading_file = File.join(root, "_data", "reading.yml")
kinds = %w[book paper article video]
Array(YAML.safe_load(File.read(reading_file), permitted_classes: [Date, Time])).each_with_index do |item, i|
  label = "_data/reading.yml entry #{i + 1} (#{item['title']})"
  problems = []
  problems << "missing title" if item["title"].to_s.strip.empty?
  problems << "type must be one of: #{kinds.join(', ')}" unless kinds.include?(item["type"])
  problems << "topic is required, one of: #{topics.join(', ')}" unless topics.include?(item["topic"])
  problems << "url is required and must start with http:// or https://" unless item["url"].to_s.match?(%r{\Ahttps?://})
  problems << "image file not found: #{item['image']}" if item["image"] && !File.exist?(File.join(root, item["image"].to_s))
  puts "warning: #{label}: url is not https; use https if the source offers it" if item["url"].to_s.start_with?("http://")
  problems << "read (the date finished) is required and must be a date" unless item["read"].respond_to?(:strftime)
  problems << "remove sample: true before publishing" if item["sample"]
  next if problems.empty?

  puts "ERROR: #{label}: #{problems.join('; ')}"
  errors += 1
end

if errors.zero?
  puts "Content front matter OK"
else
  exit 1
end
