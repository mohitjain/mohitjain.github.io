#!/usr/bin/env bash
# Build the site (with search index) and check it for broken internal links, images and scripts.
# Usage: [SKIP_BUILD=1] bin/check [--external]   (--external also checks outbound links; slow, can be flaky)
set -euo pipefail
cd "$(dirname "$0")/.."

[ -n "${SKIP_BUILD:-}" ] || bin/build

flags=(--disable-external)
[ "${1:-}" = "--external" ] && flags=(--ignore-status-codes "0,429,999")

# TODO(accessibility): the dark-mode toggle is an <a> without href; make it a <button>, then drop the next flag.
bundle exec htmlproofer ./_site --allow-missing-href "${flags[@]}"
